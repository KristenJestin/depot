{
  "name": "@netsirk/depot",
  "version": "1.0.0",
  "description": "xxxx",
  "keywords": [
    "agent",
    "ai",
    "cli",
    "opencode",
    "sqlite",
    "task-management"
  ],
  "license": "ISC",
  "author": "netsirk",
  "bin": {
    "depot": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "main": "dist/index.js",
  "imports": {
    "#/*": "./src/*"
  },
  "exports": {
    ".": "./dist/index.js",
    "./plugin": "./dist/plugin.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "bun run build",
    "depot": "bun src/cli/index.ts --",
    "db:studio": "drizzle-kit studio",
    "dev": "tsup --watch",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "lint": "oxlint src tests",
    "lint:fix": "oxlint --fix src tests",
    "test": "bun --bun vitest run",
    "test:coverage": "bun --bun vitest run --coverage",
    "test:watch": "bun --bun vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "citty": "^0.2.2",
    "drizzle-orm": "^1.0.0-beta.22",
    "ulid": "^3.0.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bun": "^1.2.15",
    "@types/node": "^25.6.0",
    "drizzle-kit": "^1.0.0-beta.22",
    "oxfmt": "^0.45.0",
    "oxlint": "^1.60.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.2",
    "vitest": "^4.1.4"
  },
  "engines": {
    "bun": ">=1.0"
  }
}
