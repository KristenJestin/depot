{
  "name": "@netsirk/depot",
  "version": "3.0.0",
  "description": "AI agent task and PRD management CLI",
  "keywords": [
    "agent",
    "ai",
    "cli",
    "opencode",
    "sqlite",
    "task-management"
  ],
  "license": "ISC",
  "author": "netsirk",
  "bin": {
    "depot": "./dist/index.mjs"
  },
  "files": [
    "dist"
  ],
  "main": "dist/index.mjs",
  "imports": {
    "#/*": "./src/*"
  },
  "exports": {
    ".": "./dist/index.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "build:web": "vp build",
    "check": "vp check",
    "prepublishOnly": "vp pack && vp build",
    "test:smoke": "vp pack && vp build && vp test tests/build",
    "depot": "vp pack && node --env-file-if-exists=.env dist/index.mjs",
    "dev:web": "vp dev",
    "dev:web:local": "bun --env-file=.env run dev:web",
    "db:check": "drizzle-kit check",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "dev": "vp pack --watch",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "lint": "vp lint src tests",
    "lint:fix": "vp lint --fix src tests",
    "test": "vp test",
    "test:coverage": "vp test --coverage",
    "test:watch": "vp test --watch",
    "typecheck": "tsc --noEmit",
    "release": "npm publish",
    "test:e2e": "vp pack && vp test run -c vitest.e2e.config.ts",
    "test:e2e:web": "playwright test",
    "test:e2e:web:ui": "playwright test --ui",
    "e2e:setup": "playwright install chromium",
    "seed": "bun run scripts/seed.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@fontsource-variable/inter": "^5.2.8",
    "@pierre/diffs": "1.1.22",
    "@pierre/trees": "1.0.0-beta.4",
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/react-query": "5.100.2",
    "@tanstack/react-router": "1.168.24",
    "citty": "^0.2.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "1.0.0-beta.22",
    "effect": "^3.21.1",
    "hono": "^4.12.14",
    "lucide-react": "^1.11.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.1.0",
    "tailwind-merge": "^3.5.0",
    "ulid": "^3.0.2"
  },
  "devDependencies": {
    "@hono/vite-dev-server": "^0.25.3",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/vite": "^4.2.4",
    "@tanstack/router-plugin": "1.167.26",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "drizzle-kit": "1.0.0-beta.22",
    "happy-dom": "^20.9.0",
    "tailwindcss": "^4.2.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.10",
    "vite-plus": "0.1.19"
  },
  "engines": {
    "node": ">=25.0"
  }
}
