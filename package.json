{
  "name": "@netsirk/depot",
  "version": "0.1.0",
  "description": "AI agent task and PRD management CLI",
  "keywords": [
    "agent",
    "ai",
    "cli",
    "opencode",
    "sqlite",
    "task-management"
  ],
  "license": "ISC",
  "author": "netsirk",
  "bin": {
    "depot": "./dist/index.mjs"
  },
  "files": [
    "dist"
  ],
  "main": "dist/index.mjs",
  "imports": {
    "#/*": "./src/*"
  },
  "exports": {
    ".": "./dist/index.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "build:web": "vp build",
    "check": "vp check",
    "prepublishOnly": "vp pack",
    "depot": "node src/index.ts --",
    "dev:web": "vp dev",
    "db:check": "drizzle-kit check",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "dev": "vp pack --watch",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "lint": "vp lint src tests",
    "lint:fix": "vp lint --fix src tests",
    "test": "vp test",
    "test:coverage": "vp test --coverage",
    "test:watch": "vp test --watch",
    "typecheck": "tsc --noEmit",
    "release": "npm publish"
  },
  "dependencies": {
    "citty": "^0.2.2",
    "drizzle-orm": "1.0.0-beta.22",
    "effect": "^3.21.1",
    "hono": "^4.12.14",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "ulid": "^3.0.2"
  },
  "devDependencies": {
    "@hono/vite-dev-server": "^0.25.3",
    "@tailwindcss/vite": "^4.2.4",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "drizzle-kit": "1.0.0-beta.22",
    "typescript": "^6.0.2",
    "vite": "^8.0.10",
    "vite-plus": "0.1.19"
  },
  "engines": {
    "node": ">=25.0"
  }
}
